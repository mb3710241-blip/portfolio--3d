# Copy this file to ".env" for local development  (Windows:  copy .env.example .env)
# On Vercel: Project -> Settings -> Environment Variables (same names).
# NEVER commit your real .env file (it is already in .gitignore).

# --- RAG chatbot (Google Gemini, free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# optional overrides
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768

# --- Contact form (Resend, free key: https://resend.com/api-keys)
RESEND_API_KEY=
# Where messages are delivered. With the default sender below this MUST be
# the same email you used to sign up on Resend.
CONTACT_TO_EMAIL=
# optional: only after verifying your own domain in Resend
# CONTACT_FROM_EMAIL=Portfolio <contact@yourdomain.com>
